{
  "manifest_version": 3,
  "name": "Fantrax Refinements",
  "version": "1.0.0",
  "description": "Small UX tweaks for Fantrax: stat tooltips + Fpts default in live scoring, and a drag-and-drop pitch editor for setting your lineup.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.fantrax.com/*"],
      "js": ["src/shared/stat-names.js", "src/content/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.fantrax.com/fantasy/league/*/team/roster*"],
      "js": [
        "src/shared/stat-names.js",
        "src/pitch-editor/state.js",
        "src/pitch-editor/roster.js",
        "src/pitch-editor/tabs.js",
        "src/pitch-editor/render.js",
        "src/pitch-editor/drag.js",
        "src/pitch-editor/tooltip.js",
        "src/pitch-editor/points-sync.js",
        "src/pitch-editor/swap.js",
        "src/pitch-editor/action-menu.js",
        "src/pitch-editor/main.js"
      ],
      "css": [
        "src/pitch-editor/pitch.css",
        "src/pitch-editor/card.css",
        "src/pitch-editor/tooltip.css",
        "src/pitch-editor/action-menu.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
