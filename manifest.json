{
  "manifest_version": 3,
  "name": "Prettier Fantrax",
  "version": "0.2.3",
  "description": "Makes Fantrax prettier: a drag-and-drop pitch editor for your lineup, a head-to-head matchup pitch for live scoring, and stat tooltips that explain every number.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.fantrax.com/*"
      ],
      "js": [
        "src/shared/stat-names.js",
        "src/content/content.js"
      ],
      "css": [
        "src/shared/theme.css",
        "src/content/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.fantrax.com/*"
      ],
      "js": [
        "src/shared/stat-names.js",
        "src/shared/touch-overlay.js",
        "src/shared/fantrax-api.js",
        "src/shared/last5.js",
        "src/shared/gameweek.js",
        "src/shared/game-status.js",
        "src/shared/lineup-alerts.js",
        "src/pitch-editor/state.js",
        "src/pitch-editor/roster.js",
        "src/pitch-editor/tabs.js",
        "src/pitch-editor/render.js",
        "src/pitch-editor/drag.js",
        "src/pitch-editor/tooltip.js",
        "src/pitch-editor/points-sync.js",
        "src/pitch-editor/swap.js",
        "src/pitch-editor/action-menu.js",
        "src/pitch-editor/main.js"
      ],
      "css": [
        "src/shared/theme.css",
        "src/shared/touch-overlay.css",
        "src/pitch-editor/pitch.css",
        "src/pitch-editor/card.css",
        "src/pitch-editor/tooltip.css",
        "src/pitch-editor/action-menu.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.fantrax.com/*"
      ],
      "js": [
        "src/shared/stat-names.js",
        "src/shared/touch-overlay.js",
        "src/shared/fantrax-api.js",
        "src/shared/last5.js",
        "src/shared/gameweek.js",
        "src/shared/game-status.js",
        "src/matchup/state.js",
        "src/matchup/parse.js",
        "src/matchup/render.js",
        "src/matchup/action-menu.js",
        "src/matchup/main.js"
      ],
      "css": [
        "src/shared/theme.css",
        "src/shared/touch-overlay.css",
        "src/matchup/matchup.css",
        "src/matchup/action-menu.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
